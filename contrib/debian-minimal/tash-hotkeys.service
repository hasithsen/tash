[Unit]
Description=tash Fn/media key daemon (brightness + volume, no DE)
Documentation=file:///usr/local/bin/tash-hotkeys
After=multi-user.target systemd-udevd.service systemd-logind.service
Wants=systemd-udevd.service

[Service]
Type=simple
# Root can open every event node (Dell WMI often appears late / strict perms).
# tash-ctl brightness/volume work fine as root on Debian minimal.
ExecStartPre=-/sbin/modprobe dell_wmi
ExecStartPre=-/sbin/modprobe dell_laptop
ExecStart=/usr/local/bin/tash-hotkeys
Restart=always
RestartSec=2
Nice=5

[Install]
WantedBy=multi-user.target
