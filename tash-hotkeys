#!/usr/bin/env bash
# tash-hotkeys — grab Fn / media keys on a bare console (no DE) via evdev
# Listens for brightness, volume, mute and calls tash-ctl.
#
# Needs read access to /dev/input/event* (group `input`, or root).
# On Debian minimal: sudo usermod -aG input $USER  && re-login
# Or: sudo ./contrib/debian-minimal/install.sh

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CTL="${TASH_CTL:-$SCRIPT_DIR/tash-ctl}"
[[ -x "$CTL" ]] || CTL="$(command -v tash-ctl 2>/dev/null || true)"
[[ -n "${CTL:-}" && -x "$CTL" ]] || { echo "tash-hotkeys: tash-ctl not found" >&2; exit 1; }

# Linux input event codes (include/uapi/linux/input-event-codes.h)
KEY_MUTE=113
KEY_VOLUMEDOWN=114
KEY_VOLUMEUP=115
KEY_BRIGHTNESSDOWN=224
KEY_BRIGHTNESSUP=225
KEY_MICMUTE=248
EV_KEY=1

# value: 0=release 1=press 2=repeat — act on press + repeat
should_handle() {
  local value="$1"
  [[ "$value" == "1" || "$value" == "2" ]]
}

handle_code() {
  local code="$1"
  case "$code" in
    "$KEY_BRIGHTNESSUP")   "$CTL" brightness up >/dev/null ;;
    "$KEY_BRIGHTNESSDOWN") "$CTL" brightness down >/dev/null ;;
    "$KEY_VOLUMEUP")       "$CTL" volume up >/dev/null ;;
    "$KEY_VOLUMEDOWN")     "$CTL" volume down >/dev/null ;;
    "$KEY_MUTE"|"$KEY_MICMUTE") "$CTL" volume toggle >/dev/null ;;
  esac
}

list_event_devices() {
  local f name
  shopt -s nullglob
  for f in /dev/input/event*; do
    # Prefer devices that look like keyboards / AT Translated Set
    name="$(cat "/sys/class/input/$(basename "$f")/device/name" 2>/dev/null || echo unknown)"
    echo "$f	$name"
  done
  shopt -u nullglob
}

# Pick devices: all event nodes the user can read (Fn keys often ride on a
# separate "Video Bus" / "Hotkey" device, not the main keyboard).
readable_events() {
  local f
  shopt -s nullglob
  for f in /dev/input/event*; do
    [[ -r "$f" ]] && echo "$f"
  done
  shopt -u nullglob
}

usage() {
  cat <<'EOF'
tash-hotkeys — Fn / media key daemon for Debian-minimal (no desktop)

Usage:
  tash-hotkeys              Listen and dispatch brightness/volume keys
  tash-hotkeys --list       List input event devices
  tash-hotkeys --test       Print matched key events (no actions)
  tash-hotkeys -h|--help

Keys handled (when the firmware emits them):
  Brightness up/down, Volume up/down, Mute, Mic mute

Requires:
  - tash-ctl in PATH or beside this script
  - read access to /dev/input/event*  (group input)
  - python3  (for binary evdev parsing)

Debian minimal setup:
  sudo ./contrib/debian-minimal/install.sh
EOF
}

MODE=run
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --list) MODE=list ;;
  --test) MODE=test ;;
  "") ;;
  *) echo "unknown option: $1" >&2; usage >&2; exit 1 ;;
esac

if [[ "$MODE" == "list" ]]; then
  echo "Readable input devices:"
  while IFS=$'\t' read -r dev name; do
    if [[ -r "$dev" ]]; then
      echo "  $dev  $name  [ok]"
    else
      echo "  $dev  $name  [permission denied — add user to group 'input']"
    fi
  done < <(list_event_devices)
  exit 0
fi

mapfile -t DEVICES < <(readable_events)
if (( ${#DEVICES[@]} == 0 )); then
  echo "tash-hotkeys: no readable /dev/input/event* devices." >&2
  echo "  sudo usermod -aG input $USER   # then log out/in" >&2
  echo "  or: sudo $0" >&2
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "tash-hotkeys: python3 is required to read evdev events." >&2
  echo "  sudo apt-get install -y python3" >&2
  echo "  (or use triggerhappy — see contrib/debian-minimal/)" >&2
  exit 1
fi

export TASH_CTL_PATH="$CTL"
export TASH_HOTKEYS_TEST="$MODE"
export TASH_HOTKEYS_DEVICES="${DEVICES[*]}"

# Multiplex all readable event devices; Fn keys often arrive on a sibling device.
exec python3 - "$MODE" "$CTL" "${DEVICES[@]}" <<'PY'
import os, struct, select, sys, subprocess

EV_KEY = 1
# timeval (2x long) + type u16 + code u16 + value s32
# On Linux: long is 8 bytes on 64-bit, 4 on 32-bit
import platform
long_sz = 8 if struct.calcsize("l") == 8 else 4
fmt = f"{long_sz}s{long_sz}sHHi"
evt_size = struct.calcsize(fmt)

CODES = {
    113: "mute",
    114: "vol-down",
    115: "vol-up",
    224: "bright-down",
    225: "bright-up",
    248: "mic-mute",
}

mode = sys.argv[1]
ctl = sys.argv[2]
paths = sys.argv[3:]

fds = []
fd_to_path = {}
for p in paths:
    try:
        fd = os.open(p, os.O_RDONLY | os.O_NONBLOCK)
        fds.append(fd)
        fd_to_path[fd] = p
    except OSError as e:
        print(f"tash-hotkeys: skip {p}: {e}", file=sys.stderr)

if not fds:
    print("tash-hotkeys: could not open any event device", file=sys.stderr)
    sys.exit(1)

print(f"tash-hotkeys: watching {len(fds)} device(s) — Ctrl+C to stop", file=sys.stderr)
if mode == "test":
    print("tash-hotkeys: TEST mode — events only, no actions", file=sys.stderr)

def act(code):
    name = CODES.get(code)
    if not name:
        return
    if mode == "test":
        print(f"event {name} (code={code})", flush=True)
        return
    cmd = {
        "bright-up":   [ctl, "brightness", "up"],
        "bright-down": [ctl, "brightness", "down"],
        "vol-up":      [ctl, "volume", "up"],
        "vol-down":    [ctl, "volume", "down"],
        "mute":        [ctl, "volume", "toggle"],
        "mic-mute":    [ctl, "volume", "toggle"],
    }[name]
    try:
        subprocess.run(cmd, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        print(f"tash-hotkeys: action failed: {e}", file=sys.stderr)

buf = {fd: b"" for fd in fds}

try:
    while True:
        r, _, _ = select.select(fds, [], [])
        for fd in r:
            try:
                chunk = os.read(fd, evt_size * 32)
            except BlockingIOError:
                continue
            if not chunk:
                continue
            buf[fd] += chunk
            while len(buf[fd]) >= evt_size:
                raw, buf[fd] = buf[fd][:evt_size], buf[fd][evt_size:]
                _, _, etype, code, value = struct.unpack(fmt, raw)
                if etype == EV_KEY and value in (1, 2) and code in CODES:
                    act(code)
except KeyboardInterrupt:
    print("\ntash-hotkeys: bye", file=sys.stderr)
finally:
    for fd in fds:
        os.close(fd)
PY
