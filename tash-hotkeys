#!/usr/bin/env bash
# tash-hotkeys — grab Fn / media keys on a bare console (no DE) via evdev
# Listens for brightness, volume, mute and calls tash-ctl.
#
# Dell Latitude (e.g. 5480): keys often arrive on "Dell WMI hotkeys", which can
# appear *after* boot — we rescan devices. Use --test to see raw key codes.
#
# Needs read access to /dev/input/event* (group `input`, or root).
# On Debian minimal: sudo ./contrib/debian-minimal/install.sh

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CTL="${TASH_CTL:-$SCRIPT_DIR/tash-ctl}"
[[ -x "$CTL" ]] || CTL="$(command -v tash-ctl 2>/dev/null || true)"
[[ -n "${CTL:-}" && -x "$CTL" ]] || { echo "tash-hotkeys: tash-ctl not found" >&2; exit 1; }

usage() {
  cat <<'EOF'
tash-hotkeys — Fn / media key daemon for Debian-minimal (no DE)

Usage:
  tash-hotkeys              Listen and dispatch brightness/volume keys
  tash-hotkeys --list       List input event devices
  tash-hotkeys --test       Print ALL key events (find Latitude/Dell codes)
  tash-hotkeys -h|--help

Dell Latitude tip:
  BIOS → Function Key Behavior → "Function Key" or try the other mode
  (Fn+Esc toggles Fn-lock on many Latitudes).
  Then: tash-hotkeys --test   and press Fn+brightness / volume

Requires: tash-ctl, python3, read access to /dev/input/event*
EOF
}

MODE=run
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --list) MODE=list ;;
  --test) MODE=test ;;
  "") ;;
  *) echo "unknown option: $1" >&2; usage >&2; exit 1 ;;
esac

list_event_devices() {
  local f name
  shopt -s nullglob
  for f in /dev/input/event*; do
    name="$(cat "/sys/class/input/$(basename "$f")/device/name" 2>/dev/null || echo unknown)"
    echo "$f	$name"
  done
  shopt -u nullglob
}

if [[ "$MODE" == "list" ]]; then
  echo "Input devices:"
  while IFS=$'\t' read -r dev name; do
    if [[ -r "$dev" ]]; then
      echo "  $dev  $name  [ok]"
    else
      echo "  $dev  $name  [permission denied — group 'input' or root]"
    fi
  done < <(list_event_devices)
  echo
  if lsmod 2>/dev/null | grep -q '^dell_wmi'; then
    echo "Dell WMI module: loaded"
  else
    echo "Dell WMI module: missing — try: sudo modprobe dell_wmi"
  fi
  exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "tash-hotkeys: python3 required (sudo apt-get install -y python3)" >&2
  exit 1
fi

# Best-effort: Dell Latitude hotkeys need these modules
modprobe dell_wmi 2>/dev/null || true
modprobe dell_laptop 2>/dev/null || true
modprobe intel_backlight 2>/dev/null || true

export TASH_CTL_PATH="$CTL"
export TASH_HOTKEYS_MODE="$MODE"

exec python3 - "$MODE" "$CTL" <<'PY'
"""Watch all /dev/input/event*; rescan when Dell WMI appears late."""
from __future__ import annotations

import glob
import os
import select
import struct
import subprocess
import sys
import time

EV_KEY = 1
EV_SYN = 0
EV_MSC = 4
MSC_SCAN = 4

# timeval: two native longs + type u16 + code u16 + value s32
LONG_SZ = struct.calcsize("l")
FMT = f"{LONG_SZ}s{LONG_SZ}sHHi"
EVT_SIZE = struct.calcsize(FMT)

# Linux input-event-codes.h — extend via TASH_EXTRA_KEYS=code:brightness:up,...
ACTIONS = {
    113: ("mute", ["volume", "toggle"]),
    114: ("vol-down", ["volume", "down"]),
    115: ("vol-up", ["volume", "up"]),
    224: ("bright-down", ["brightness", "down"]),
    225: ("bright-up", ["brightness", "up"]),
    240: ("bright-min", ["brightness", "set", "1"]),
    241: ("bright-max", ["brightness", "set", "100"]),
    248: ("mic-mute", ["volume", "toggle"]),
}

for item in os.environ.get("TASH_EXTRA_KEYS", "").split(","):
    item = item.strip()
    if not item:
        continue
    parts = item.split(":")
    if len(parts) < 3:
        continue
    try:
        c = int(parts[0], 0)
    except ValueError:
        continue
    ACTIONS[c] = (f"extra-{c}", parts[1:])

mode = sys.argv[1]
ctl = sys.argv[2]

def device_name(path: str) -> str:
    base = os.path.basename(path)
    for cand in (
        f"/sys/class/input/{base}/device/name",
        f"/sys/class/input/{base}/name",
    ):
        try:
            with open(cand, encoding="utf-8", errors="replace") as f:
                return f.read().strip()
        except OSError:
            continue
    return "unknown"


def list_readable() -> list[str]:
    paths = sorted(glob.glob("/dev/input/event*"))
    out = []
    for p in paths:
        if os.access(p, os.R_OK):
            out.append(p)
    return out


def open_devices(paths: list[str], existing: dict[int, str]) -> dict[int, str]:
    """Return fd -> path map, keeping already-open fds."""
    have_paths = set(existing.values())
    for p in paths:
        if p in have_paths:
            continue
        try:
            fd = os.open(p, os.O_RDONLY | os.O_NONBLOCK)
        except OSError as e:
            print(f"tash-hotkeys: skip {p}: {e}", file=sys.stderr)
            continue
        existing[fd] = p
        name = device_name(p)
        print(f"tash-hotkeys: + {p}  ({name})", file=sys.stderr)
    return existing


def drop_stale(fdmap: dict[int, str]) -> dict[int, str]:
    alive = set(list_readable())
    gone = [fd for fd, p in fdmap.items() if p not in alive]
    for fd in gone:
        p = fdmap.pop(fd)
        try:
            os.close(fd)
        except OSError:
            pass
        print(f"tash-hotkeys: - {p}", file=sys.stderr)
    return fdmap


def act(code: int, dev: str, value: int) -> None:
    info = ACTIONS.get(code)
    name = device_name(dev)
    if mode == "test":
        label = info[0] if info else "other"
        print(
            f"key code={code} value={value} action={label}  via {dev} ({name})",
            flush=True,
        )
        return
    if not info:
        return
    _, argv = info
    try:
        subprocess.run(
            [ctl, *argv],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception as e:
        print(f"tash-hotkeys: action failed: {e}", file=sys.stderr)


fdmap: dict[int, str] = {}
buf: dict[int, bytes] = {}
last_scan = 0.0
SCAN_EVERY = 2.0

fdmap = open_devices(list_readable(), fdmap)
if not fdmap:
    print("tash-hotkeys: no readable /dev/input/event* devices.", file=sys.stderr)
    print("  sudo usermod -aG input $USER  # re-login", file=sys.stderr)
    print("  or: sudo tash-hotkeys", file=sys.stderr)
    sys.exit(1)

print(f"tash-hotkeys: watching {len(fdmap)} device(s) — Ctrl+C to stop", file=sys.stderr)
if mode == "test":
    print(
        "tash-hotkeys: TEST — press Fn+brightness / volume; "
        "ALL key codes print (even unknown)",
        file=sys.stderr,
    )
    print(
        "tash-hotkeys: on Latitude, prefer the 'Dell WMI hotkeys' line",
        file=sys.stderr,
    )

for fd in fdmap:
    buf[fd] = b""

try:
    while True:
        now = time.monotonic()
        if now - last_scan >= SCAN_EVERY:
            last_scan = now
            fdmap = drop_stale(fdmap)
            before = set(fdmap)
            fdmap = open_devices(list_readable(), fdmap)
            for fd in fdmap:
                if fd not in before:
                    buf[fd] = b""

        if not fdmap:
            time.sleep(SCAN_EVERY)
            continue

        timeout = SCAN_EVERY
        r, _, _ = select.select(list(fdmap.keys()), [], [], timeout)
        for fd in r:
            path = fdmap.get(fd)
            if path is None:
                continue
            try:
                chunk = os.read(fd, EVT_SIZE * 64)
            except BlockingIOError:
                continue
            except OSError:
                # device yanked
                try:
                    os.close(fd)
                except OSError:
                    pass
                fdmap.pop(fd, None)
                buf.pop(fd, None)
                continue
            if not chunk:
                continue
            buf[fd] = buf.get(fd, b"") + chunk
            while len(buf[fd]) >= EVT_SIZE:
                raw, buf[fd] = buf[fd][:EVT_SIZE], buf[fd][EVT_SIZE:]
                try:
                    _, _, etype, code, value = struct.unpack(FMT, raw)
                except struct.error:
                    buf[fd] = b""
                    break
                if etype != EV_KEY:
                    continue
                if value not in (1, 2):  # press + repeat
                    continue
                if mode == "test" or code in ACTIONS:
                    act(code, path, value)
except KeyboardInterrupt:
    print("\ntash-hotkeys: bye", file=sys.stderr)
finally:
    for fd in list(fdmap):
        try:
            os.close(fd)
        except OSError:
            pass
PY
