#!/usr/bin/env bash
# tash — Terminal Awesome System HUD
# A slightly judgmental dashboard for your machine.
# On bare Debian (no DE): pair with tash-hotkeys for Fn brightness/volume keys.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CTL="${TASH_CTL:-$SCRIPT_DIR/tash-ctl}"
[[ -x "$CTL" ]] || CTL="$(command -v tash-ctl 2>/dev/null || echo "$SCRIPT_DIR/tash-ctl")"

REFRESH="${TASH_REFRESH:-2}"
ONCE=0
NO_COLOR=0
CONTROLS=1
FLASH=""
FLASH_TTL=0

# CPU sample state (no sleep-in-draw)
CPU_PREV_TOTAL=""
CPU_PREV_IDLE=""

usage() {
  cat <<'EOF'
tash — Terminal Awesome System HUD

Usage: tash [options]

Options:
  -r, --refresh SEC   Refresh interval in seconds (default: 2)
  -1, --once          Draw once and exit
  -n, --no-color      Disable colors (for terminals that fear joy)
      --no-controls   Hide brightness/volume + disable in-dashboard keys
  -h, --help          Show this help

In-dashboard keys (TTY / terminal — always available):
  [  ]     brightness down / up
  -  =     volume down / up
  m        mute toggle
  q        quit

Fn / media keys (Debian minimal, no DE):
  Run the hotkey daemon so firmware keys reach tash-ctl:
    sudo ./contrib/debian-minimal/install.sh
    # or: tash-hotkeys
  Those work system-wide, even when tash is not open.

Environment:
  TASH_REFRESH        Default refresh interval
  TASH_CTL            Path to tash-ctl
  TASH_STYLE          auto|rich|minimal|ascii  (auto detects linux console)
  TASH_BASIC_COLOR=1  Force 16-color ANSI (good for Debian tty)
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -r|--refresh) REFRESH="${2:?}"; shift 2 ;;
    -1|--once) ONCE=1; shift ;;
    -n|--no-color) NO_COLOR=1; shift ;;
    --no-controls) CONTROLS=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

# ── display style (elegant where rich; clear on Debian minimal / tty) ───────
# TASH_STYLE=auto|rich|minimal|ascii
# TASH_BASIC_COLOR=1  force 16-color ANSI
detect_style() {
  local want="${TASH_STYLE:-auto}"
  case "$want" in
    rich|minimal|ascii) echo "$want"; return ;;
  esac
  # auto (default): prefer clarity on bare Linux consoles
  case "${TERM:-}" in
    dumb|unknown|"") echo ascii; return ;;
    # Linux virtual console / classic VTs: 16 colors, high-contrast glyphs
    linux|vt100|vt102|vt220|ansi|cygwin) echo minimal; return ;;
  esac
  local loc="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
  if [[ "$loc" != *[Uu][Tt][Ff]?8* && "$loc" != *[Uu][Tt][Ff]-8* ]]; then
    echo ascii
    return
  fi
  echo rich
}

STYLE="$(detect_style)"

# Glyphs: bars need high contrast (━/─ look identical without 256-color)
case "$STYLE" in
  ascii)
    BAR_ON='#'
    BAR_OFF='-'
    RULE_CH='-'
    RULE_CORNER='--'
    DOT='*'
    PLUG='+'
    FLASH_MARK='>'
    ;;
  minimal)
    # Block elements are in typical Debian console fonts; clearly readable
    BAR_ON='█'
    BAR_OFF='░'
    RULE_CH='─'
    RULE_CORNER='──'
    DOT='·'
    PLUG='*'
    FLASH_MARK='>'
    ;;
  *)
    BAR_ON='█'
    BAR_OFF='░'
    RULE_CH='─'
    RULE_CORNER='──'
    DOT='·'
    PLUG='⚡'
    FLASH_MARK='›'
    ;;
esac

# Colors: soft 256 on rich terminals; 16-color on linux console / minimal
if [[ "$NO_COLOR" -eq 1 ]] || [[ ! -t 1 ]]; then
  R= G= Y= B= M= C= W= D= BOLD= DIM= ITAL= RESET=
  ACC= MUTED= SOFT= FG=
elif [[ "$STYLE" == "rich" && -z "${TASH_BASIC_COLOR:-}" && "${TERM:-}" != "dumb" ]]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; ITAL=$'\033[3m'; RESET=$'\033[0m'
  R=$'\033[38;5;167m'   # soft rose
  G=$'\033[38;5;108m'   # sage
  Y=$'\033[38;5;179m'   # warm amber
  B=$'\033[38;5;110m'   # soft blue
  M=$'\033[38;5;139m'   # mauve
  C=$'\033[38;5;73m'    # teal
  W=$'\033[38;5;253m'   # near-white
  D=$'\033[38;5;240m'   # charcoal
  ACC=$'\033[38;5;73m'
  MUTED=$'\033[38;5;245m'
  SOFT=$'\033[38;5;250m'
  FG=$'\033[38;5;252m'
else
  # Debian minimal / Linux console: reliable 16-color ANSI
  BOLD=$'\033[1m'; DIM=$'\033[2m'; ITAL=$'\033[3m'; RESET=$'\033[0m'
  R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; B=$'\033[34m'
  M=$'\033[35m'; C=$'\033[36m'; W=$'\033[37m'; D=$'\033[90m'
  ACC=$'\033[36m'
  MUTED=$'\033[90m'
  SOFT=$'\033[37m'
  FG=$'\033[1;37m'
fi

# Hairline rule (width chars)
rule() {
  local width="${1:-56}" label="${2:-}" i
  if [[ -n "$label" ]]; then
    local pad=$(( width - ${#label} - 4 ))
    (( pad < 2 )) && pad=2
    printf "%s%s %s " "$D" "$RULE_CORNER" "$label"
    for (( i = 0; i < pad; i++ )); do printf "%s" "$RULE_CH"; done
    printf "%s" "$RESET"
  else
    printf "%s" "$D"
    for (( i = 0; i < width; i++ )); do printf "%s" "$RULE_CH"; done
    printf "%s" "$RESET"
  fi
}

# Fixed-width section label
lbl() {
  printf "%s%-4s%s" "${1:-$MUTED}" "$2" "$RESET"
}

# High-contrast progress bar. Guarantees a visible tick for 1–99%.
bar() {
  local pct="${1:-0}" width="${2:-28}" invert="${3:-0}"
  local filled empty i color
  # coerce junk / newlines from sysfs
  pct="${pct%%[!0-9]*}"
  pct="${pct:-0}"
  (( pct < 0 )) && pct=0
  (( pct > 100 )) && pct=100
  (( width < 4 )) && width=4

  filled=$(( pct * width / 100 ))
  empty=$(( width - filled ))
  # show level even when integer math would round to an empty/full bar
  if (( pct > 0 && filled == 0 )); then
    filled=1
    empty=$(( width - 1 ))
  elif (( pct < 100 && empty == 0 )); then
    filled=$(( width - 1 ))
    empty=1
  fi

  if (( invert )); then
    color="$G"
    (( pct <= 30 )) && color="$Y"
    (( pct <= 15 )) && color="$R"
  else
    color="$G"
    (( pct >= 70 )) && color="$Y"
    (( pct >= 90 )) && color="$R"
  fi

  printf "%s" "$color"
  for (( i = 0; i < filled; i++ )); do printf "%s" "$BAR_ON"; done
  printf "%s" "$D"
  for (( i = 0; i < empty; i++ )); do printf "%s" "$BAR_OFF"; done
  printf "%s" "$RESET"
}

human_bytes() {
  local bytes="${1:-0}"
  if command -v numfmt >/dev/null 2>&1; then
    numfmt --to=iec --suffix=B "$bytes" 2>/dev/null && return
  fi
  local units=(B KiB MiB GiB TiB) i=0
  local val="$bytes"
  while (( val >= 1024 && i < ${#units[@]} - 1 )); do
    val=$(( val / 1024 ))
    (( i++ )) || true
  done
  printf "%s %s" "$val" "${units[$i]}"
}

detect_os() {
  case "$(uname -s)" in
    Linux*)  echo "linux" ;;
    Darwin*) echo "darwin" ;;
    MINGW*|MSYS*|CYGWIN*) echo "windows" ;;
    *)       echo "unknown" ;;
  esac
}

OS="$(detect_os)"

get_hostname() {
  hostname 2>/dev/null || uname -n 2>/dev/null || echo "mystery-box"
}

get_uptime_str() {
  if [[ "$OS" == "darwin" ]]; then
    local boot now
    boot="$(sysctl -n kern.boottime 2>/dev/null | awk -F'[=,]' '{print $2}' | tr -d ' ')"
    now="$(date +%s)"
    if [[ -n "$boot" ]]; then
      local sec=$(( now - boot ))
      local d=$(( sec / 86400 )) h=$(( (sec % 86400) / 3600 )) m=$(( (sec % 3600) / 60 ))
      printf "%dd %dh %dm" "$d" "$h" "$m"
      return
    fi
  fi
  if [[ -r /proc/uptime ]]; then
    local sec
    sec="$(awk '{print int($1)}' /proc/uptime)"
    local d=$(( sec / 86400 )) h=$(( (sec % 86400) / 3600 )) m=$(( (sec % 3600) / 60 ))
    printf "%dd %dh %dm" "$d" "$h" "$m"
    return
  fi
  uptime 2>/dev/null | sed 's/.*up //; s/,.*//' || echo "eternity"
}

get_load() {
  if [[ -r /proc/loadavg ]]; then
    awk '{printf "%s %s %s", $1, $2, $3}' /proc/loadavg
  elif [[ "$OS" == "darwin" ]]; then
    sysctl -n vm.loadavg 2>/dev/null | tr -d '{}' | awk '{printf "%s %s %s", $1, $2, $3}'
  else
    uptime 2>/dev/null | awk -F'load average[s]?: ' '{print $2}' | tr -d ',' || echo "? ? ?"
  fi
}

get_cpu_count() {
  if [[ "$OS" == "darwin" ]]; then
    sysctl -n hw.ncpu 2>/dev/null || echo 1
  elif [[ -r /proc/cpuinfo ]]; then
    grep -c '^processor' /proc/cpuinfo 2>/dev/null || nproc 2>/dev/null || echo 1
  else
    nproc 2>/dev/null || echo 1
  fi
}

get_cpu_model() {
  if [[ "$OS" == "darwin" ]]; then
    sysctl -n machdep.cpu.brand_string 2>/dev/null || echo "Apple Mystery Chip"
  elif [[ -r /proc/cpuinfo ]]; then
    grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^ *//' || echo "Unknown CPU"
  else
    echo "Unknown CPU"
  fi
}

read_cpu_times() {
  # prints: total idle
  awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8,$5}' /proc/stat 2>/dev/null
}

get_cpu_pct() {
  if [[ -r /proc/stat ]]; then
    local total idle
    read -r total idle <<<"$(read_cpu_times)"
    if [[ -n "$CPU_PREV_TOTAL" ]]; then
      local dt=$(( total - CPU_PREV_TOTAL ))
      local di=$(( idle - CPU_PREV_IDLE ))
      CPU_PREV_TOTAL=$total
      CPU_PREV_IDLE=$idle
      if (( dt > 0 )); then
        echo $(( (100 * (dt - di)) / dt ))
      else
        echo 0
      fi
    else
      CPU_PREV_TOTAL=$total
      CPU_PREV_IDLE=$idle
      # seed with a tiny sample so --once still shows something useful
      sleep 0.08
      read -r total idle <<<"$(read_cpu_times)"
      local dt=$(( total - CPU_PREV_TOTAL ))
      local di=$(( idle - CPU_PREV_IDLE ))
      CPU_PREV_TOTAL=$total
      CPU_PREV_IDLE=$idle
      if (( dt > 0 )); then
        echo $(( (100 * (dt - di)) / dt ))
      else
        echo 0
      fi
    fi
  elif [[ "$OS" == "darwin" ]]; then
    top -l 1 -n 0 2>/dev/null | awk '/CPU usage/ {
      gsub(/%/,"",$3); gsub(/%/,"",$5);
      printf "%d", $3+$5
    }' || echo 0
  else
    echo 0
  fi
}

get_mem() {
  if [[ "$OS" == "darwin" ]]; then
    local page total free inactive speculative wired compressed used pct
    page="$(sysctl -n hw.pagesize 2>/dev/null || echo 4096)"
    total="$(sysctl -n hw.memsize 2>/dev/null || echo 0)"
    free="$(vm_stat 2>/dev/null | awk '/Pages free/{gsub(/\./,"",$3); print $3}')"
    inactive="$(vm_stat 2>/dev/null | awk '/Pages inactive/{gsub(/\./,"",$3); print $3}')"
    speculative="$(vm_stat 2>/dev/null | awk '/Pages speculative/{gsub(/\./,"",$3); print $3}')"
    free=${free:-0}; inactive=${inactive:-0}; speculative=${speculative:-0}
    used=$(( total - (free + speculative + inactive) * page ))
    (( used < 0 )) && used=0
    if (( total > 0 )); then
      pct=$(( used * 100 / total ))
    else
      pct=0
    fi
    printf "%s %s %s" "$used" "$total" "$pct"
  elif [[ -r /proc/meminfo ]]; then
    local total avail used pct
    total="$(awk '/MemTotal/{print $2*1024}' /proc/meminfo)"
    avail="$(awk '/MemAvailable/{print $2*1024}' /proc/meminfo)"
    used=$(( total - avail ))
    pct=$(( used * 100 / total ))
    printf "%s %s %s" "$used" "$total" "$pct"
  else
    printf "0 0 0"
  fi
}

get_swap() {
  if [[ "$OS" == "darwin" ]]; then
    local total used
    total="$(sysctl -n vm.swapusage 2>/dev/null | awk '{print $3}' | tr -d 'M')"
    used="$(sysctl -n vm.swapusage 2>/dev/null | awk '{print $6}' | tr -d 'M')"
    total=${total%.*}; used=${used%.*}
    total=${total:-0}; used=${used:-0}
    local pct=0
    (( total > 0 )) && pct=$(( used * 100 / total ))
    printf "%s %s %s" "$(( used * 1024 * 1024 ))" "$(( total * 1024 * 1024 ))" "$pct"
  elif [[ -r /proc/meminfo ]]; then
    local total used pct
    total="$(awk '/SwapTotal/{print $2*1024}' /proc/meminfo)"
    used="$(awk '/SwapTotal/{t=$2} /SwapFree/{print (t-$2)*1024}' /proc/meminfo)"
    if (( total > 0 )); then
      pct=$(( used * 100 / total ))
    else
      pct=0
    fi
    printf "%s %s %s" "$used" "$total" "$pct"
  else
    printf "0 0 0"
  fi
}

get_disk() {
  local line
  if line="$(df -Pk / 2>/dev/null | awk 'NR==2{print $3*1024, $2*1024, $5}' | tr -d '%')"; then
    echo "$line"
  else
    echo "0 0 0"
  fi
}

get_procs() {
  if command -v ps >/dev/null 2>&1; then
    ps -e 2>/dev/null | wc -l | tr -d ' ' | awk '{print $1-1}'
  else
    echo "?"
  fi
}

get_users() {
  who 2>/dev/null | wc -l | tr -d ' ' || echo 0
}

get_kernel() {
  uname -sr 2>/dev/null || echo "unknown"
}

get_ip() {
  if command -v ip >/dev/null 2>&1; then
    ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}' \
      || hostname -I 2>/dev/null | awk '{print $1}'
  elif [[ "$OS" == "darwin" ]]; then
    ipconfig getifaddr en0 2>/dev/null \
      || ipconfig getifaddr en1 2>/dev/null \
      || echo "offline-vibes"
  else
    hostname -I 2>/dev/null | awk '{print $1}' || echo "?"
  fi
}

# Humanize seconds → "2h 15m" / "45m" / "n/a"
format_duration() {
  local secs="$1"
  local h m
  if [[ ! "$secs" =~ ^[0-9]+$ ]] || (( secs <= 0 )); then
    echo "n/a"
    return
  fi
  # Cap absurd readings (bad sensors / idle power_now)
  (( secs > 48 * 3600 )) && { echo "n/a"; return; }
  h=$(( secs / 3600 ))
  m=$(( (secs % 3600) / 60 ))
  if (( h > 0 )); then
    printf "%dh %02dm" "$h" "$m"
  else
    printf "%dm" "$m"
  fi
}

# Estimate seconds until empty (discharging) or full (charging) from sysfs.
# prints: seconds kind   kind = empty|full|n/a
battery_eta_from_sysfs() {
  local bat="$1" status="$2"
  local energy_now energy_full power_now
  local charge_now charge_full current_now
  local tte ttf secs=0 kind="n/a"

  # Prefer firmware-reported ETAs when present (seconds)
  if [[ "$status" == "Discharging" && -r "$bat/time_to_empty_now" ]]; then
    tte="$(cat "$bat/time_to_empty_now" 2>/dev/null || echo 0)"
    if [[ "$tte" =~ ^[0-9]+$ ]] && (( tte > 0 && tte < 200000 )); then
      echo "$tte empty"
      return
    fi
  fi
  if [[ "$status" == "Charging" && -r "$bat/time_to_full_now" ]]; then
    ttf="$(cat "$bat/time_to_full_now" 2>/dev/null || echo 0)"
    if [[ "$ttf" =~ ^[0-9]+$ ]] && (( ttf > 0 && ttf < 200000 )); then
      echo "$ttf full"
      return
    fi
  fi

  # energy_* (µWh) + power_now (µW)
  if [[ -r "$bat/energy_now" && -r "$bat/power_now" ]]; then
    energy_now="$(cat "$bat/energy_now")"
    power_now="$(cat "$bat/power_now")"
    power_now="${power_now#-}" # some kernels sign by direction
    if [[ "$power_now" =~ ^[0-9]+$ ]] && (( power_now > 0 )); then
      if [[ "$status" == "Discharging" ]]; then
        secs=$(( energy_now * 3600 / power_now ))
        kind="empty"
      elif [[ "$status" == "Charging" && -r "$bat/energy_full" ]]; then
        energy_full="$(cat "$bat/energy_full")"
        if (( energy_full > energy_now )); then
          secs=$(( (energy_full - energy_now) * 3600 / power_now ))
          kind="full"
        fi
      fi
    fi
  # charge_* (µAh) + current_now (µA)
  elif [[ -r "$bat/charge_now" && -r "$bat/current_now" ]]; then
    charge_now="$(cat "$bat/charge_now")"
    current_now="$(cat "$bat/current_now")"
    current_now="${current_now#-}"
    if [[ "$current_now" =~ ^[0-9]+$ ]] && (( current_now > 0 )); then
      if [[ "$status" == "Discharging" ]]; then
        secs=$(( charge_now * 3600 / current_now ))
        kind="empty"
      elif [[ "$status" == "Charging" && -r "$bat/charge_full" ]]; then
        charge_full="$(cat "$bat/charge_full")"
        if (( charge_full > charge_now )); then
          secs=$(( (charge_full - charge_now) * 3600 / current_now ))
          kind="full"
        fi
      fi
    fi
  fi

  if [[ "$kind" != "n/a" ]] && (( secs > 0 )); then
    echo "$secs $kind"
  else
    echo "n/a n/a"
  fi
}

# prints: pct status eta_secs eta_kind
# status = Charging|Discharging|Full|Unknown|n/a
# eta_kind = empty|full|n/a
get_battery() {
  if [[ "$OS" == "darwin" ]]; then
    local line pct status="Unknown" eta_secs="n/a" eta_kind="n/a" hm
    line="$(pmset -g batt 2>/dev/null | grep -E '[0-9]+%')" || { echo "n/a n/a n/a n/a"; return; }
    pct="$(grep -oE '[0-9]+%' <<<"$line" | head -1 | tr -d '%')"
    grep -qi charging <<<"$line" && status="Charging"
    grep -qi discharging <<<"$line" && status="Discharging"
    grep -qi charged <<<"$line" && status="Full"
    # e.g. "3:42 remaining" or "1:23 until full"
    if hm="$(grep -oE '[0-9]+:[0-9]+' <<<"$line" | head -1)" && [[ -n "$hm" ]]; then
      local h="${hm%%:*}" m="${hm##*:}"
      eta_secs=$(( 10#$h * 3600 + 10#$m * 60 ))
      if grep -qi 'until full\|charging' <<<"$line" && [[ "$status" == "Charging" ]]; then
        eta_kind="full"
      else
        eta_kind="empty"
      fi
    fi
    echo "${pct:-0} $status $eta_secs $eta_kind"
    return
  fi
  local bat cap status eta_secs eta_kind
  shopt -s nullglob
  for bat in /sys/class/power_supply/BAT* /sys/class/power_supply/bat*; do
    [[ -r "$bat/capacity" ]] || continue
    cap="$(cat "$bat/capacity")"
    status="$(cat "$bat/status" 2>/dev/null || echo Unknown)"
    read -r eta_secs eta_kind <<<"$(battery_eta_from_sysfs "$bat" "$status")"
    shopt -u nullglob
    echo "$cap $status $eta_secs $eta_kind"
    return
  done
  shopt -u nullglob
  echo "n/a n/a n/a n/a"
}

# AC power connected? 1/0/n/a
get_ac_online() {
  local d
  shopt -s nullglob
  for d in /sys/class/power_supply/A{C,DP}* /sys/class/power_supply/ACAD*; do
    if [[ -r "$d/online" ]]; then
      cat "$d/online"
      shopt -u nullglob
      return
    fi
  done
  shopt -u nullglob
  echo "n/a"
}

# Find a wireless interface name (wlan0, wlp…, etc.)
wifi_iface() {
  local iface
  if [[ -d /sys/class/net ]]; then
    for iface in /sys/class/net/*; do
      [[ -d "$iface/wireless" || -L "$iface/phy80211" ]] || continue
      basename "$iface"
      return
    done
  fi
  if command -v iw >/dev/null 2>&1; then
    iw dev 2>/dev/null | awk '/Interface/{print $2; exit}'
  fi
}

# prints: state ssid signal_pct
# state = up|down|n/a
# ssid may be "unknown" when associated but tools can't read the name
get_wifi() {
  if [[ "$OS" == "darwin" ]]; then
    local ssid sig
    ssid="$(networksetup -getairportnetwork en0 2>/dev/null | sed 's/.*: //')"
    if [[ -z "$ssid" || "$ssid" == *"not associated"* ]]; then
      echo "down none n/a"
    else
      sig="$(airport -I 2>/dev/null | awk '/agrCtlRSSI/{print $2}')"
      # RSSI is negative; rough map -30..-90 → 100..0
      if [[ "$sig" =~ ^-?[0-9]+$ ]]; then
        sig=$(( (sig + 90) * 100 / 60 ))
        (( sig < 0 )) && sig=0
        (( sig > 100 )) && sig=100
      else
        sig="n/a"
      fi
      echo "up ${ssid// /_} $sig"
    fi
    return
  fi

  local iface state="down" ssid="" signal="n/a" qual carrier ipaddr link

  iface="$(wifi_iface)"
  if [[ -z "$iface" ]]; then
    echo "n/a none n/a"
    return
  fi

  if [[ -r "/sys/class/net/$iface/operstate" ]]; then
    state="$(cat "/sys/class/net/$iface/operstate" 2>/dev/null || echo down)"
  fi
  carrier="$(cat "/sys/class/net/$iface/carrier" 2>/dev/null || echo 0)"

  # Associated / has L3 even when operstate is quirky (common on bare installs)
  if [[ "$state" != "up" ]]; then
    if [[ "$carrier" == "1" ]]; then
      state="up"
    elif command -v ip >/dev/null 2>&1; then
      ipaddr="$(ip -4 -o addr show dev "$iface" 2>/dev/null | awk '{print $4}' | head -1)"
      [[ -n "$ipaddr" ]] && state="up"
    fi
  fi
  [[ "$state" == "up" ]] || state="down"

  # SSID — try whatever is installed (Debian minimal often has none of these)
  if command -v iwgetid >/dev/null 2>&1; then
    ssid="$(iwgetid -r "$iface" 2>/dev/null || true)"
  fi
  if [[ -z "$ssid" ]] && command -v iw >/dev/null 2>&1; then
    link="$(iw dev "$iface" link 2>/dev/null || true)"
    if [[ "$link" != *"Not connected"* ]]; then
      ssid="$(printf '%s\n' "$link" | awk -F': ' '/SSID/{print $2; exit}')"
      # iw link succeeding means associated even without SSID line
      if [[ -n "$link" && "$state" != "up" ]]; then
        state="up"
      fi
    fi
  fi
  if [[ -z "$ssid" ]] && command -v nmcli >/dev/null 2>&1; then
    ssid="$(nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}')"
  fi
  if [[ -z "$ssid" ]] && command -v wpa_cli >/dev/null 2>&1; then
    ssid="$(wpa_cli -i "$iface" status 2>/dev/null | awk -F= '/^ssid=/{print $2; exit}')"
    if [[ -z "$ssid" ]]; then
      # wpa_state=COMPLETED ⇒ associated
      if wpa_cli -i "$iface" status 2>/dev/null | grep -q '^wpa_state=COMPLETED'; then
        state="up"
      fi
    fi
  fi
  if [[ -z "$ssid" ]] && command -v iwctl >/dev/null 2>&1; then
    ssid="$(iwctl station "$iface" show 2>/dev/null \
      | sed -n 's/.*Connected network[[:space:]]*//p' | head -1 | tr -d '\r')"
  fi

  if [[ -n "$ssid" ]]; then
    state="up"
    ssid="${ssid// /_}"
  elif [[ "$state" == "up" ]]; then
    # Connected but no wireless-tools/iw/nmcli — don't lie and say disconnected
    ssid="unknown"
  else
    ssid="none"
  fi

  # Signal %
  if command -v iw >/dev/null 2>&1; then
    qual="$(iw dev "$iface" link 2>/dev/null | awk '/signal:/{print $2; exit}')"
    if [[ "$qual" =~ ^-?[0-9]+$ ]]; then
      # dBm → rough percent
      signal=$(( (qual + 90) * 100 / 60 ))
      (( signal < 0 )) && signal=0
      (( signal > 100 )) && signal=100
    fi
  fi
  if [[ "$signal" == "n/a" ]] && [[ -r /proc/net/wireless ]]; then
    signal="$(awk -v ifc="$iface" '$1 ~ ifc":"{ gsub(/\./,"",$3); printf "%d", $3 }' /proc/net/wireless)"
    [[ -z "$signal" ]] && signal="n/a"
  fi
  if [[ "$signal" == "n/a" ]] && command -v nmcli >/dev/null 2>&1; then
    signal="$(nmcli -t -f ACTIVE,SIGNAL dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}')"
    signal="${signal:-n/a}"
  fi

  echo "$state $ssid $signal"
}

# prints: state iface ip   state = up|down|n/a
get_ethernet() {
  local iface state ipaddr
  if [[ ! -d /sys/class/net ]]; then
    echo "n/a none n/a"
    return
  fi
  shopt -s nullglob
  for iface in /sys/class/net/e* /sys/class/net/en*; do
    [[ -e "$iface" ]] || continue
    [[ -d "$iface/wireless" || -L "$iface/phy80211" ]] && continue
    local name
    name="$(basename "$iface")"
    [[ "$name" == "lo" ]] && continue
    state="$(cat "$iface/operstate" 2>/dev/null || echo down)"
    ipaddr="n/a"
    if command -v ip >/dev/null 2>&1; then
      ipaddr="$(ip -4 -o addr show dev "$name" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
      ipaddr="${ipaddr:-n/a}"
    fi
    shopt -u nullglob
    echo "$state $name $ipaddr"
    return
  done
  shopt -u nullglob
  echo "n/a none n/a"
}

# Gateway reachability without blocking long: use carrier + default route
# prints: online|offline|unknown
get_connectivity() {
  if command -v nmcli >/dev/null 2>&1; then
    case "$(nmcli -t networking connectivity 2>/dev/null || true)" in
      full|limited|portal) echo online; return ;;
      none) echo offline; return ;;
    esac
  fi
  if command -v ip >/dev/null 2>&1; then
    if ip route show default 2>/dev/null | grep -q .; then
      echo online
    else
      echo offline
    fi
    return
  fi
  echo unknown
}

get_timezone() {
  date +%Z 2>/dev/null || echo local
}

ctl_ok() { [[ -x "$CTL" ]]; }

get_brightness_pct() {
  ctl_ok || { echo "n/a"; return; }
  local out
  out="$("$CTL" brightness get 2>/dev/null | tr -d '%')" || { echo "n/a"; return; }
  [[ "$out" =~ ^[0-9]+$ ]] && echo "$out" || echo "n/a"
}

get_volume_state() {
  # prints: pct muted(0|1) or n/a 1
  ctl_ok || { echo "n/a 1"; return; }
  local out pct=0 muted=0
  out="$("$CTL" volume get 2>/dev/null)" || { echo "n/a 1"; return; }
  if [[ "$out" == "n/a" || -z "$out" ]]; then echo "n/a 1"; return; fi
  if [[ "$out" == *muted* ]]; then muted=1; fi
  pct="$(grep -oE '[0-9]+' <<<"$out" | head -1)"
  echo "${pct:-0} $muted"
}

mood() {
  local cpu="$1" mem="$2" disk="$3"
  if (( cpu >= 90 || mem >= 95 || disk >= 95 )); then
    echo "${R}panicking quietly${RESET}"
  elif (( cpu >= 70 || mem >= 80 || disk >= 85 )); then
    echo "${Y}mildly concerned${RESET}"
  elif (( cpu < 20 && mem < 40 )); then
    echo "${G}living its best life${RESET}"
  else
    echo "${C}vibing${RESET}"
  fi
}

set_flash() {
  FLASH="$1"
  FLASH_TTL=3
}

do_control() {
  local action="$1"
  ctl_ok || { set_flash "tash-ctl missing"; return; }
  local out
  case "$action" in
    bright-up)   out="$("$CTL" brightness up 2>&1)" || out="brightness failed" ;;
    bright-down) out="$("$CTL" brightness down 2>&1)" || out="brightness failed" ;;
    vol-up)      out="$("$CTL" volume up 2>&1)" || out="volume failed" ;;
    vol-down)    out="$("$CTL" volume down 2>&1)" || out="volume failed" ;;
    mute)        out="$("$CTL" volume toggle 2>&1)" || out="mute failed" ;;
  esac
  set_flash "$out"
}

handle_key() {
  local key="$1"
  case "$key" in
    q|Q) exit 0 ;;
    ']') do_control bright-up ;;
    '[') do_control bright-down ;;
    '='|'+') do_control vol-up ;;
    '-'|'_') do_control vol-down ;;
    m|M) do_control mute ;;
  esac
}

format_battery_line() {
  local pct="$1" status="$2" ac="$3" eta_secs="${4:-n/a}" eta_kind="${5:-n/a}"
  local label plug="" life="" life_h
  if [[ "$pct" == "n/a" ]]; then
    echo "${MUTED}no battery${RESET}  ${D}desktop energy${RESET}"
    return
  fi
  case "$status" in
    Charging)       label="${G}charging${RESET}" ; plug="${Y}${PLUG}${RESET}" ;;
    Full)           label="${G}full${RESET}" ; plug="${Y}${PLUG}${RESET}" ;;
    Discharging)    label="${SOFT}discharging${RESET}" ;;
    "Not charging") label="${SOFT}plugged${RESET}" ; plug="${Y}${PLUG}${RESET}" ;;
    *)              label="${MUTED}${status}${RESET}" ;;
  esac
  if [[ "$ac" == "1" && "$status" == "Discharging" ]]; then
    plug="${Y}${PLUG}${RESET}"
  fi
  life_h="$(format_duration "$eta_secs")"
  if [[ "$life_h" != "n/a" ]]; then
    case "$eta_kind" in
      empty) life="${D}  ${DOT}  ${RESET}${FG}${life_h}${RESET}${D} left${RESET}" ;;
      full)  life="${D}  ${DOT}  ${RESET}${FG}${life_h}${RESET}${D} to full${RESET}" ;;
    esac
  elif [[ "$status" == "Full" ]]; then
    life="${D}  ${DOT}  ${RESET}${G}topped up${RESET}"
  fi
  printf "%s  %s%s%%${RESET}%s  %s%s" \
    "$(bar "$pct" 28 1)" "$BOLD$FG" "$pct" "${plug:+ $plug}" "$label" "$life"
}

format_wifi_line() {
  local state="$1" ssid="$2" signal="$3"
  if [[ "$state" == "n/a" ]]; then
    echo "${MUTED}no interface${RESET}"
    return
  fi
  if [[ "$state" != "up" ]]; then
    echo "${R}disconnected${RESET}  ${D}lonely packets${RESET}"
    return
  fi
  local pretty sigbit=""
  case "$ssid" in
    none|unknown|"") pretty="${MUTED}ssid unknown${RESET}${D} — apt install iw${RESET}" ;;
    *) pretty="${FG}${ssid//_/ }${RESET}" ;;
  esac
  if [[ "$signal" =~ ^[0-9]+$ ]]; then
    sigbit="$(bar "$signal" 12) ${MUTED}${signal}%${RESET}"
  else
    sigbit="${D}signal —${RESET}"
  fi
  echo "${G}connected${RESET}  $pretty  $sigbit"
}

format_eth_line() {
  local state="$1" iface="$2" ipaddr="$3"
  if [[ "$state" == "n/a" || "$iface" == "none" ]]; then
    echo "${MUTED}none${RESET}"
    return
  fi
  if [[ "$state" == "up" ]]; then
    echo "${G}up${RESET}  ${FG}${iface}${RESET}  ${MUTED}${ipaddr}${RESET}"
  else
    echo "${MUTED}down${RESET}  ${D}${iface}${RESET}"
  fi
}

draw() {
  local cpu_pct mem_u mem_t mem_p swap_u swap_t swap_p disk_u disk_t disk_p
  local load cores model host up kernel ip procs users
  local clock_hms clock_date clock_tz
  local bat_p bat_s bat_eta bat_eta_kind ac_on wifi_st wifi_ssid wifi_sig eth_st eth_if eth_ip net_conn
  local bright_p vol_p vol_m controls_block flash_line
  local bat_line wifi_line eth_line conn_label

  cpu_pct="$(get_cpu_pct)"
  read -r mem_u mem_t mem_p <<<"$(get_mem)"
  read -r swap_u swap_t swap_p <<<"$(get_swap)"
  read -r disk_u disk_t disk_p <<<"$(get_disk)"
  load="$(get_load)"
  cores="$(get_cpu_count)"
  model="$(get_cpu_model)"
  host="$(get_hostname)"
  up="$(get_uptime_str)"
  kernel="$(get_kernel)"
  ip="$(get_ip)"
  procs="$(get_procs)"
  users="$(get_users)"

  clock_hms="$(date '+%H:%M:%S')"
  clock_date="$(date '+%a %Y-%m-%d')"
  clock_tz="$(get_timezone)"

  read -r bat_p bat_s bat_eta bat_eta_kind <<<"$(get_battery)"
  ac_on="$(get_ac_online)"
  read -r wifi_st wifi_ssid wifi_sig <<<"$(get_wifi)"
  read -r eth_st eth_if eth_ip <<<"$(get_ethernet)"
  net_conn="$(get_connectivity)"

  bright_p="$(get_brightness_pct)"
  read -r vol_p vol_m <<<"$(get_volume_state)"

  bat_line="$(format_battery_line "$bat_p" "$bat_s" "$ac_on" "$bat_eta" "$bat_eta_kind")"
  wifi_line="$(format_wifi_line "$wifi_st" "$wifi_ssid" "$wifi_sig")"
  eth_line="$(format_eth_line "$eth_st" "$eth_if" "$eth_ip")"

  case "$net_conn" in
    online)  conn_label="${G}online${RESET}" ;;
    offline) conn_label="${R}offline${RESET}" ;;
    *)       conn_label="${D}unknown${RESET}" ;;
  esac

  if (( CONTROLS )); then
    local bbar vbar
    if [[ "$bright_p" == "n/a" ]]; then
      bbar="${MUTED}no backlight${RESET}"
    else
      bbar="$(bar "$bright_p" 28)  ${FG}${bright_p}%${RESET}"
    fi
    if [[ "$vol_p" == "n/a" ]]; then
      vbar="${MUTED}no volume backend${RESET}${D} — alsa-utils${RESET}"
    else
      if (( vol_m )); then
        vbar="$(bar 0 28)  ${R}muted${RESET} ${D}(${vol_p}%)${RESET}"
      else
        vbar="$(bar "$vol_p" 28)  ${FG}${vol_p}%${RESET}"
      fi
    fi
    controls_block=$(cat <<EOF

  $(rule 56 controls)
  $(lbl "$ACC" "BRI")  $bbar
  $(lbl "$ACC" "VOL")  $vbar
  ${D}     [ ] bright   - = volume   m mute   q quit${RESET}
EOF
)
  else
    controls_block=""
  fi

  if (( FLASH_TTL > 0 )) && [[ -n "$FLASH" ]]; then
    flash_line="
  ${ACC}${FLASH_MARK}${RESET} ${SOFT}${FLASH}${RESET}"
    (( FLASH_TTL-- )) || true
  else
    flash_line=""
    FLASH=""
  fi

  local mood_line mem_detail swap_detail disk_detail
  mood_line="$(mood "$cpu_pct" "$mem_p" "$disk_p")"
  mem_detail="${MUTED}$(human_bytes "$mem_u")${RESET}${D} / ${RESET}${MUTED}$(human_bytes "$mem_t")${RESET}"
  swap_detail="${MUTED}$(human_bytes "$swap_u")${RESET}${D} / ${RESET}${MUTED}$(human_bytes "$swap_t")${RESET}"
  disk_detail="${MUTED}$(human_bytes "$disk_u")${RESET}${D} / ${RESET}${MUTED}$(human_bytes "$disk_t")${RESET}${D}  /${RESET}"

  printf '\033[2J\033[H'

  cat <<EOF

  ${BOLD}${ACC}tash${RESET}  ${D}terminal awesome system hud${RESET}
  ${BOLD}${FG}${clock_hms}${RESET}  ${MUTED}${clock_date}${RESET}  ${D}${clock_tz}${RESET}

  ${BOLD}${FG}${host}${RESET}
  ${MUTED}${kernel}${RESET}  ${D}${DOT}${RESET}  ${MUTED}${ip:-?}${RESET}

  $(rule 56)
  ${MUTED}mood${RESET}    $mood_line
  ${MUTED}up${RESET}      ${FG}${up}${RESET}  ${D}${DOT}${RESET}  ${MUTED}load${RESET} ${SOFT}${load}${RESET} ${D}(${cores}c)${RESET}
  ${MUTED}users${RESET}   ${FG}${users}${RESET}  ${D}${DOT}${RESET}  ${MUTED}procs${RESET} ${SOFT}${procs}${RESET}

  $(rule 56 power)
  $(lbl "$Y" "BAT")  $bat_line
  $(lbl "$B" "WIFI")  $wifi_line
  $(lbl "$B" "ETH")  $eth_line
  $(lbl "$MUTED" "NET")  $conn_label  ${D}${DOT}${RESET}  ${MUTED}${ip:-?}${RESET}

  $(rule 56 resources)
  $(lbl "$B" "CPU")  $(bar "$cpu_pct" 28)  ${FG}${cpu_pct}%${RESET}
       ${D}${model}${RESET}
  $(lbl "$M" "MEM")  $(bar "$mem_p" 28)  ${FG}${mem_p}%${RESET}  $mem_detail
  $(lbl "$Y" "SWAP")  $(bar "$swap_p" 28)  ${FG}${swap_p}%${RESET}  $swap_detail
  $(lbl "$G" "DISK")  $(bar "$disk_p" 28)  ${FG}${disk_p}%${RESET}  $disk_detail
${controls_block}${flash_line}

  ${D}refresh ${REFRESH}s  ${DOT}  judging quietly since 2026${RESET}
EOF
}

STTY_SAVE=""
CLEANED=0

restore_tty() {
  (( CLEANED )) && return
  CLEANED=1
  if [[ -n "$STTY_SAVE" ]]; then
    stty "$STTY_SAVE" 2>/dev/null || stty sane 2>/dev/null || true
  else
    stty sane 2>/dev/null || true
  fi
  printf '\033[?25h' 2>/dev/null || true
}

cleanup() {
  restore_tty
  # Only print goodbye when we actually ran the interactive UI
  if [[ -n "$STTY_SAVE" ]]; then
    echo
    echo "${D}tash out.${RESET} ${MUTED}your secrets are safe. probably.${RESET}"
  fi
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

printf '\033[?25l'

if [[ "$ONCE" -eq 1 ]]; then
  draw
  printf '\033[?25h'
  CLEANED=1  # skip restore_tty noise; we never changed stty
  exit 0
fi

# Save full tty state, then raw-ish mode for single keypresses
STTY_SAVE="$(stty -g 2>/dev/null || true)"
stty -echo -icanon time 0 min 0 2>/dev/null || true

while true; do
  draw
  # wait up to REFRESH seconds for a key; drain extra bytes from escape seqs
  if read -r -n 1 -t "$REFRESH" key 2>/dev/null; then
    # skip escape sequences (arrows etc.)
    if [[ "$key" == $'\033' ]]; then
      read -r -n 1 -t 0.01 _ || true
      read -r -n 1 -t 0.01 _ || true
      continue
    fi
    (( CONTROLS )) && handle_key "$key"
    # immediate redraw after control
    continue
  fi
done
